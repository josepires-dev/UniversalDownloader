{
  "manifest_version": 3,
  "name": "Universal Downloader",
  "version": "2.1.0",
  "key": "",
  "description": "Botão de download no Instagram e YouTube via UniversalDownloader local. Arranca o servidor sozinho.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "cookies",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*"
  ],
  "action": {
    "default_title": "Universal Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "ig-diag.js",
        "instagram-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}